<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kullanıcı Cihazları</title>
    <link
      rel="icon"
      type="image/x-icon"
      href="https://www.tescom-ups.com/images/anchor_amblem.svg"
    />
    <link rel="stylesheet" href="/navbar.css" />
    <link rel="stylesheet" href="/devices.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="logo">
        <h1>Tescom</h1>
        <p>Kesintisiz Güç Kaynakları</p>
      </div>
      <ul class="nav-links">
        <li><a href="/">Ana Sayfa</a></li>
        <li><a href="/profile">Profil</a></li>
        <li><a href="/devices" class="active">Cihazlar</a></li>
        <li><a href="/auth/logout" class="logout">Çıkış</a></li>
      </ul>
    </nav>

    <div class="container">
      <div class="dashboard-header">
        <h1>UPS Cihaz Yönetimi</h1>
        <div>
          <a href="/user/devices/alarms" class="alarms-btn">Alarmlar</a>
          <a href="/user/devices/add" class="add-device-btn">+ Yeni Cihaz Ekle</a>
        </div>
      </div>

      <div class="filters-section">
        <div class="filter-group">
          <label for="locationFilter">Konum:</label>
          <select id="locationFilter" onchange="filterDevices()">
            <option value="">Tüm Konumlar</option>
            <option value="Istanbul">İstanbul</option>
            <option value="Izmir">İzmir</option>
            <option value="Antalya">Antalya</option>
            <option value="Ankara">Ankara</option>
            <option value="Bursa">Bursa</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="modelFilter">Model:</label>
          <select id="modelFilter" onchange="filterDevices()">
            <option value="">Tüm Modeller</option>
            <option value="Model - A">Model - A</option>
            <option value="Model - B">Model - B</option>
            <option value="Model - C">Model - C</option>
            <option value="Model - X">Model - X</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="statusFilter">Durum:</label>
          <select id="statusFilter" onchange="filterDevices()">
            <option value="">Tüm Durumlar</option>
            <option value="online">Çevrimiçi</option>
            <option value="offline">Çevrimdışı</option>
          </select>
        </div>
      </div>

      <div id="device-data" class="devices-grid">
        {{#each devices}}
          <div
            class="device"
            id="device-{{this.mac_address}}"
            data-model="{{this.model}}"
            data-location="{{this.location}}"
          >
            <div class="device-header">
              <div class="device-name">
                <h2>{{this.device_name}}</h2>
                <span class="device-model">{{this.model}}</span>
              </div>
              <div class="status-badge">
                <span id="status-{{this.mac_address}}">--</span>
              </div>
            </div>

            <div class="device-info-grid">
              <div class="info-item">
                <div class="info-label">MAC Adresi</div>
                <div class="info-value">{{this.mac_address}}</div>
              </div>
              <div class="info-item">
                <div class="info-label">Konum</div>
                <div class="info-value">{{this.location}}</div>
              </div>
              <div class="info-item">
                <div class="info-label">Sıcaklık</div>
                <div class="info-value" id="temp-{{this.mac_address}}">--</div>
              </div>
              <div class="info-item">
                <div class="info-label">Pil Seviyesi</div>
                <div class="info-value">
                  <div class="battery-indicator">
                    <div
                      class="battery-level"
                      id="battery-level-{{this.mac_address}}"
                    ></div>
                  </div>
                  <span id="battery-{{this.mac_address}}">--</span>
                </div>
              </div>
              <div class="info-item">
                <div class="info-label">Giriş Volt</div>
                <div class="info-value" id="giris-{{this.mac_address}}">--</div>
              </div>
              <div class="info-item">
                <div class="info-label">Çıkış Volt</div>
                <div class="info-value" id="cikis-{{this.mac_address}}">--</div>
              </div>
            </div>

            <div class="device-footer">
              <div class="alarm-badge" id="alarm-{{this.mac_address}}">--</div>
              <button
                class="toggle-btn"
                id="btn-{{this.mac_address}}"
                onclick="toggleDevice('{{this.mac_address}}')"
              >
                Durum Değiştir
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    </div>

    <script src="/userDevicesScript.js"></script>
  </body>
</html>